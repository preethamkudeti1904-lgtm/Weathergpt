# ================================================================
# WEATHERGPT ENVIRONMENT CONFIGURATION
# Conversational AI for Weather Forecasting, Alerts & Climate Information
# IMD / Ministry of Earth Sciences (MoES) SIH Platform
# ================================================================

# Application
APP_NAME=WeatherGPT
API_V1_STR=/api
SECRET_KEY=super-secret-weathergpt-sih-key-change-in-prod-2026

# Database
# Production: PostgreSQL (e.g. postgresql://user:password@localhost:5432/weathergpt)
# Local Dev fallback: SQLite
DATABASE_URL=sqlite:///./weathergpt.db

# Weather Provider
# Options: "open-meteo" (zero-key required, real WMO global data), "openweather", "weatherapi", "imd"
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
IMD_API_KEY=

# Artificial Intelligence (LLM) Provider
# Supports Google Gemini, OpenAI, or built-in Grounded Meteorological Semantic Engine
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto

# Mapping & Satellite Imagery
# Built-in: Esri World Imagery (Satellite), OpenStreetMap (Road), CartoDB (Labels)
GOOGLE_MAPS_API_KEY=

# Controlled Demo Mode (False = Real live APIs; True = Synthetic simulation clearly marked as DEMO DATA)
DEMO_MODE=False
